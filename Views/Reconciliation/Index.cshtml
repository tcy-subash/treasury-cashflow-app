@{
    ViewData["Title"] = "Reconciliation";
}

<div style="text-align:center;padding:4rem 1rem;">
    <div style="font-size:3.5rem;margin-bottom:1rem;opacity:.5;">
        <i class="fa-solid fa-scale-balanced" style="color:#2dd4bf;"></i>
    </div>
    <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:.6rem;">Reconciliation</h1>
    <p style="color:#64748b;max-width:420px;margin:0 auto 2rem;font-size:.9rem;">
        This module is under development and will be available in a future release.
        It will cover bank statement reconciliation, ledger matching, and audit trails.
    </p>
    <a asp-controller="Dashboard" asp-action="Index"
       style="display:inline-flex;align-items:center;gap:.5rem;
              padding:.65rem 1.4rem;background:rgba(20,184,166,.12);
              border:1px solid rgba(20,184,166,.25);border-radius:10px;
              color:#2dd4bf;font-size:.88rem;font-weight:600;text-decoration:none;">
        <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
    </a>
</div>
