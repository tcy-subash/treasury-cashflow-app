@{
    ViewData["Title"] = "Access Denied";
}

<div style="text-align:center;padding:4rem 1rem;">
    <div style="font-size:3.5rem;margin-bottom:1rem;opacity:.6;">
        <i class="fa-solid fa-shield-halved" style="color:#e11d48;"></i>
    </div>
    <h1 style="font-size:1.6rem;font-weight:700;margin-bottom:.6rem;">Access Denied</h1>
    <p style="color:#64748b;max-width:420px;margin:0 auto 2rem;">
        You do not have permission to access this page.
        Contact your administrator if you believe this is an error.
    </p>
    <a asp-controller="Dashboard" asp-action="Index"
       style="display:inline-flex;align-items:center;gap:.5rem;
              padding:.65rem 1.4rem;background:rgba(2,132,199,.15);
              border:1px solid rgba(2,132,199,.3);border-radius:10px;
              color:#38bdf8;font-size:.88rem;font-weight:600;text-decoration:none;
              transition:background .2s;">
        <i class="fa-solid fa-arrow-left"></i> Return to Dashboard
    </a>
</div>
